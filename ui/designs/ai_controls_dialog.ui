<ui version="4.0">
 <class>AIControlsDialog</class>
 <widget class="QDialog" name="AIControlsDialog">
  <property name="windowTitle"><string>AI Controls</string></property>
  <property name="minimumSize"><size><width>540</width><height>0</height></size></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="scopeLabel">
    <property name="text"><string>Administrator controls for this installation. These settings apply to all accounts.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
   <item><widget class="QLabel" name="sourceLabel"><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QCheckBox" name="useEnvironmentCheckBox"><property name="text"><string>Use environment defaults</string></property></widget></item>
   <item><widget class="QGroupBox" name="policyGroup">
    <property name="title"><string>Desktop admin overrides</string></property>
    <layout class="QVBoxLayout" name="policyLayout">
     <item><widget class="QCheckBox" name="allowAICheckBox"><property name="text"><string>Allow AI features</string></property></widget></item>
     <item><widget class="QGroupBox" name="featuresGroup">
      <property name="title"><string>Allowed features</string></property>
      <layout class="QVBoxLayout" name="featuresLayout">
       <item><widget class="QCheckBox" name="conversationCheckBox"><property name="text"><string>Conversation and reflection</string></property></widget></item>
       <item><widget class="QCheckBox" name="commandInterpretationCheckBox"><property name="text"><string>Natural-language command interpretation</string></property></widget></item>
       <item><widget class="QCheckBox" name="personalizedMessagesCheckBox"><property name="text"><string>Personalized messages</string></property></widget></item>
       <item><widget class="QCheckBox" name="actionPlanningCheckBox"><property name="text"><string>Action planning</string></property></widget></item>
       <item><widget class="QCheckBox" name="responseEnhancementCheckBox"><property name="text"><string>Response enhancement</string></property></widget></item>
       <item><widget class="QCheckBox" name="taskBreakdownCheckBox"><property name="text"><string>Task breakdown (Simplify)</string></property></widget></item>
       <item><widget class="QCheckBox" name="taskEffortCheckBox"><property name="text"><string>Task effort estimates</string></property></widget></item>
      </layout>
     </widget></item>
    </layout>
   </widget></item>
   <item><widget class="QLabel" name="behaviorLabel">
    <property name="text"><string>Turning AI off keeps core commands, reminders, and fallbacks available. Disabled features do not return cached AI replies. Save applies to new requests in the desktop app and running service; requests already in progress may finish.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
   <item><widget class="QDialogButtonBox" name="buttonBox"><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set></property></widget></item>
  </layout>
