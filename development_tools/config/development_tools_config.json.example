      "development_tools/CONSOLIDATED_REPORT.md",
      "development_tools/reports/analysis_detailed_results.json",
      "ui/generated/*"
    ],
    "historical_preserve_files": [
      "*_PLAN",
      ".cursor/plans",
      ".plan.md",
      "AI_CHANGELOG.md",
      "archive/",
      "CHANGELOG_DETAIL.md",
      "logs/",
      "development_docs/changelog_history/",
      "CHANGELOG_*.md"
    ],
    "base_exclusions_removals": [
      ".pytest_runtime",
      ".cursor",
      "backups",
      "scripts/*",
      "*/scripts/*",
      "tests/__pycache__",
      "tests/.pytest_cache",
      "pytest-tmp-*",
      "pytest-of-*",
      "pytest_tmp_*",
      "*/pytest-tmp-*",
      "*/pytest-of-*",
      "*/pytest_tmp_*"
    ]
  },
